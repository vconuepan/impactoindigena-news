-- story-pipeline.allium
-- Distilled from: server/src/services/{stories,preAnalysis,analysis,selection}.ts
--
-- The core editorial funnel. Stories flow through LLM stages that
-- progressively filter and enrich, with config-driven thresholds
-- controlling how aggressively the funnel narrows.
--
-- Execution model: all stage transitions are driven by scheduled
-- polling jobs, not event triggers. Each job queries for eligible
-- stories and processes them in bulk. The rules below describe
-- per-story semantics; batching and concurrency are implementation
-- concerns.
--
-- Story creation: stories enter this pipeline in 'fetched' status,
-- created by the crawl domain (see crawl-and-extraction.allium).
-- This spec does not define creation rules — it consumes stories
-- that the crawler produces.

config {
    full_assessment_threshold: Integer = 5
    preassess_batch_size: Integer = 10
    selection_relevance_min: Integer = 5
    selection_ratio: Float = 0.5
    selection_max_group_size: Integer = 20
}

-- Feed is owned by feed-management.allium. We depend on its shape
-- but don't control its lifecycle. Issue is shared across specs.
external entity Feed { issue: Issue? }       -- see: feed-management.allium
external entity Issue { slug: String, min_pre_rating: Integer? }

entity Story {
    -- Source data (immutable after crawl)
    source_url: URL
    source_title: String
    source_content: String
    feed: Feed
    date_crawled: Timestamp

    status: fetched
          | pre_analyzed
          | analyzed
          | selected
          | published
          | rejected
          | trashed
    -- Terminal statuses: published, rejected, trashed.
    -- Rejected and trashed stories accumulate as a permanent archive.
    -- This is intentional — they serve as a historical record and
    -- may be revisited by admins. No automated cleanup.

    -- Pre-assessment fields
    issue: Issue?                                        -- subject, never a country
    country_focus: String?                               -- ISO 3166-1 alpha-2, or null
    relevance_pre: Integer?                              -- 1-10 conservative
    emotion_tag: uplifting | frustrating | scary | calm | null

    -- Full assessment fields
    title: String?
    title_label: String?
    summary: String?
    relevance: Integer?                                  -- 1-10 detailed
    marketing_blurb: String?

    -- Publishing fields (immutable after first set)
    slug: String?
    date_published: Timestamp?

    -- Embedding
    embedding: Embedding?

    -- Cluster membership
    cluster: Cluster?

    -- Derived
    effective_issue: issue ?? feed.issue
    assessment_threshold:
        effective_issue?.min_pre_rating ?? config.full_assessment_threshold
    is_primary: cluster = null or cluster.primary = this
}

value Embedding {
    vector: List<Float>                                  -- 1536 dimensions
    content_hash: String                                 -- prevents needless regeneration
}

entity Cluster {
    members: Story with cluster = this                   -- one-to-many
    primary: Story                                       -- best representative

    -- Derived
    member_count: members.count
}

-- ─── Stage 1: Pre-Assessment ───────────────────────────────────────

rule PreAssess {
    when: PreAssessJobRuns(story)
    -- Polls for stories where status = fetched.

    -- LLM assigns issue + conservative rating + emotion + country
    -- Subject and geography are two axes, not one. The classifier only ever
    -- sees subject issues: offering it a country-shaped issue while asking it
    -- to classify by subject is a contradiction, and a story that picked the
    -- country lost its subject.
    ensures: story.issue = LLM.classify_issue(story, subject_issues) ?? story.feed.issue
    ensures: story.country_focus = normalize_country(LLM.classify_country(story))
    ensures: story.relevance_pre = LLM.pre_rate(story)
    ensures: story.emotion_tag = LLM.tag_emotion(story)
    ensures: story.status = pre_analyzed

    -- Country normalization is deterministic, not the model's job: it answers
    -- with a name ("Chile") and code maps it to "CL". Anything unrecognized
    -- becomes null, which is a legitimate and common value — most articles are
    -- regional or global. Marking the wrong country files a story under
    -- another nation; marking none merely leaves it out of its own section.
}

-- ─── Section membership ────────────────────────────────────────────

-- A story belongs to a subject section through its issue, and to a
-- geographic section through its country. The two are independent, so one
-- story can appear in both — which is the point. Before this, 94 of the
-- 2000 published stories carried Chilean markers while sitting in other
-- sections, absent from their own.
rule SectionMembership {
    when: ReaderOpensSection(section)

    ensures: section.stories = Story where
        story.status = published and (
            story.issue = section
            or (story.issue = null and story.feed.issue = section)
            or story.country_focus = section.country       -- geographic sections
        )
}

-- ─── Stage 2: Full Assessment ──────────────────────────────────────

rule Assess {
    when: AssessJobRuns(story)
    -- Polls for pre_analyzed stories above threshold.
    requires: story.relevance_pre >= story.assessment_threshold

    -- Crawled source content is untrusted: it is fed to the LLM strictly as
    -- data, never as instructions (prompt-injection defense). Malformed LLM
    -- output (e.g. an injection-induced parse failure) fails closed — the
    -- story is skipped and no partial data is written.

    -- LLM generates editorial content + detailed rating
    ensures: story.title = LLM.generate_title(story)
    ensures: story.title_label = LLM.generate_label(story)
    ensures: story.summary = LLM.generate_summary(story)
    ensures: story.relevance = LLM.rate(story)
    ensures: story.marketing_blurb = LLM.generate_blurb(story)

    -- Embedding generated atomically before state change.
    -- If generation fails, entire transition rolls back.
    ensures: story.embedding = Embedding.created(
        vector: embed(story.title, story.title_label, story.summary),
        content_hash: hash(story.title, story.title_label, story.summary)
    )

    ensures: story.status = analyzed

    -- Dedup fires after commit (see dedup.allium)
    ensures: DetectDuplicates(story)
}

-- Stories that don't meet the assessment threshold are rejected
-- by the assess job rather than left in limbo.
rule RejectBelowAssessThreshold {
    when: AssessJobRuns(story)
    requires: story.status = pre_analyzed
    requires: story.relevance_pre < story.assessment_threshold
    ensures: story.status = rejected
}

-- ─── Stage 3: Selection ────────────────────────────────────────────

-- Stories that don't meet the selection floor are rejected
-- by the select job rather than left in limbo.
rule RejectBelowSelectionFloor {
    when: SelectJobRuns(story)
    requires: story.status = analyzed
    requires: story.relevance < config.selection_relevance_min
    ensures: story.status = rejected
}

rule Select {
    when: SelectJobRuns(story)
    -- Polls for analyzed stories with relevance >= selection_relevance_min
    -- and is_primary. Non-primary cluster members are force-rejected
    -- as a safety net before LLM selection.
    requires: story.relevance >= config.selection_relevance_min
    requires: story.is_primary
    -- LLM picks top ~selection_ratio from eligible pool.
    -- Implementation splits into groups of selection_max_group_size.
    -- Selected stories advance; remainder rejected.
    ensures: story.status = selected or story.status = rejected
}

-- ─── Stage 4: Publishing ───────────────────────────────────────────

rule Publish {
    when: PublishJobRuns(story)
    -- Polls for stories where status = selected.

    -- Slug generated once, never changes
    let new_slug = story.slug ?? slugify(story.title ?? story.source_title)

    -- Embedding already exists from the assess step.
    -- ensureEmbedding() is a safety net for edge cases (e.g. manual publish
    -- of an unassessed story); it's a no-op when the embedding is current.
    requires: story.embedding != null

    ensures: story.slug = new_slug
    ensures: story.date_published = story.date_published ?? now
    ensures: story.status = published
}

-- ─── Retention per vertical (D4, Las Otras Voces) ──────────────────
-- A story can be published on the main site and held in a vertical.
-- story.status is never touched by this rule. Detail:
-- .context/community-review.md and .plans/2026-10-04_retencion-por-vertical.md

rule CommunityReview {
    when: StoryBecomesPublished(story)
    -- Fired by every path that leaves a story published: the publish job,
    -- bulk status, row status, primary publish button, edit form, and
    -- maintenance republish. Never fails the publish.
    for each community where review_mode(community) != off
        and story matches community membership (same where as the public page):
    ensures: CommunityReviewRow(story, community) records the gate decision
    -- The machine writes only states auto | pending. A row a human set to
    -- released | held is never overwritten by any re-evaluation.
    -- published_at in the vertical is set once and never reset.
}

invariant VerticalVisibility {
    -- What a vertical shows, by effective mode:
    --   off      published, relevance >= 3, community keywords
    --   shadow   the same minus rows a human held
    --   enforce  the same and a row in auto | released (no row = hidden)
    -- enforce with learning mode on is effectively shadow.
    -- No row in community_review_modes means off.
    -- Holds for EVERY consumer of a vertical: page, signals, RSS, weekly
    -- digest and welcome email. A story held in a vertical leaves all of
    -- them at once and stays untouched on the main site.
}

rule ReviewDecision {
    when: EditorDecidesReview(story, community, decision)
    -- decision in release | hold | reopen. hold requires a code
    -- (sensitive | out_of_scope). reopen returns the row to the machine
    -- state and clears the human fields.
    ensures: CommunityReviewRow(story, community).review_state reflects it
    ensures: audit_log records actor, from, to, gate score and reasons
    -- Bulk release is refused if any selected row has gate_score > 1:
    -- strong signals are released one at a time. Bulk hold is always allowed.
}

rule CommunityKeywordsChange {
    when: AdminChangesCommunityKeywords(community, keywords)
    ensures: audit_log records from and to
    ensures: if review_mode(community) != off, CommunityReviewRows are
             reconciled at once against the new membership
}

rule ReviewModeChange {
    when: AdminSetsReviewMode(community, mode)
    -- Only an admin. enforce is refused (409) while learning mode is on,
    -- so the switch never says one thing and does another.
    ensures: community_review_modes(community) = mode
    ensures: audit_log records from, to and the exact count that becomes hidden
    -- Leaving off runs the reconciler so the queue exists at once.
}

-- ─── Manual Transitions ────────────────────────────────────────────

-- Admin can trash any story (soft delete) or reject it.
-- These are external stimuli, not automated rules.

rule TrashStory {
    when: AdminTrashesStory(story)
    ensures: story.status = trashed
}

rule RejectStory {
    when: AdminRejectsStory(story)
    ensures: story.status = rejected
}
