# =============================================================================
# Voces Indígenas — variables de entorno del backend
# =============================================================================
#
# Copiar a `server/.env` y completar. Este archivo es la referencia completa:
# toda variable que el código lee está acá, con su valor por defecto real.
#
# CONVENCIONES
#   [OBLIGATORIA]  sin ella el servidor no arranca o no hace su trabajo
#   [opcional]     tiene default; el valor mostrado es el que aplica si se omite
#   [desactiva]    si falta, esa funcionalidad se apaga sin romper el arranque
#
# Los valores de este archivo son PLACEHOLDERS. Nunca commitear `.env` real.
# =============================================================================


# -----------------------------------------------------------------------------
# 1 · Núcleo — sin esto no arranca
# -----------------------------------------------------------------------------

# [OBLIGATORIA] PostgreSQL con extensión pgvector instalada.
DATABASE_URL="postgresql://user:password@localhost:5432/impactoindigena_ai?schema=public"

# [OBLIGATORIA] 32+ caracteres aleatorios. Firma los JWT de sesión.
JWT_SECRET="cambiar-por-un-string-aleatorio-de-al-menos-32-caracteres"

# [OBLIGATORIA] URL pública del backend. Se usa para armar enlaces en correos.
# URL publica del backend, para los enlaces de los correos (verificacion de
# suscripcion, alertas, enlace magico). En produccion es el MISMO host que el
# frontend: el Static Web App enruta /api/* al App Service, y no existe un
# subdominio api.* — este archivo documentaba uno que nunca se creo, y un
# enlace de verificacion construido con el no lleva a ninguna parte.
# En desarrollo, http://localhost:3001
API_URL="https://vocesindigenas.org"

# [OBLIGATORIA] URL del frontend. Controla CORS.
FRONTEND_URL="https://vocesindigenas.org"

# [opcional] URL del sitio para enlaces en posts sociales y correos.
SITE_URL="https://vocesindigenas.org"

# [opcional] Igual que SITE_URL, usada en enlaces de autenticación y suscripción.
CLIENT_URL="https://vocesindigenas.org"

# [opcional | default 3001] Azure App Service lo inyecta solo.
PORT=3001

# [opcional] `production` activa logs en formato JSON y oculta detalles de error.
NODE_ENV=development

# [desactiva] Clave para acceder a rutas protegidas sin sesión. Si falta, no hay
# acceso por API key.
# PUBLIC_API_KEY=


# -----------------------------------------------------------------------------
# 2 · Proveedor LLM
# -----------------------------------------------------------------------------
# Tres tiers de modelo: SMALL (pre-evaluación, alto volumen), MEDIUM (análisis),
# LARGE (redacción editorial). Ver `.context/llm-analysis.md`.

# [opcional | default openai] azure | openai | openrouter
LLM_PROVIDER=azure

# --- Azure OpenAI (cuando LLM_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
AZURE_OPENAI_API_KEY=
# [opcional | default 2025-01-01-preview]
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# [opcional] Nombres de los deployments, no de los modelos.
AZURE_OPENAI_DEPLOYMENT_SMALL=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_MEDIUM=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_LARGE=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-small
AZURE_OPENAI_DEPLOYMENT_TTS=tts-1-hd
AZURE_OPENAI_DEPLOYMENT_DALLE=dall-e-3

# --- OpenAI directo (cuando LLM_PROVIDER=openai) ---
# OPENAI_API_KEY="sk-..."
# [opcional] Modelos por tier.
# OPENAI_MODEL_SMALL=gpt-5.4-mini
# OPENAI_MODEL_MEDIUM=gpt-5.4-mini
# OPENAI_MODEL_LARGE=gpt-5.4

# --- OpenRouter (cuando LLM_PROVIDER=openrouter) ---
# OPENROUTER_API_KEY=

# [opcional | default 500] Pausa entre llamadas LLM, en ms.
LLM_DELAY_MS=500


# -----------------------------------------------------------------------------
# 3 · Extracción de contenido
# -----------------------------------------------------------------------------
# Cadena de tres niveles: selector CSS propio → Mozilla Readability → API externa.
# Ver `.context/content-extraction.md`.

# [opcional | default diffbot] diffbot | pipfeed
EXTRACTION_API=diffbot

# [desactiva] Sin token, el tercer nivel de extracción no corre.
DIFFBOT_TOKEN=
# [opcional | default 5] Peticiones por segundo.
DIFFBOT_RATE_LIMIT=5
# [opcional | default 15000]
DIFFBOT_TIMEOUT_MS=15000

# [desactiva] Alternativa a Diffbot.
PIPFEED_API_KEY=
# [opcional | default 15000]
PIPFEED_TIMEOUT_MS=15000

# [opcional | default 10000] Timeout de las peticiones HTTP del crawler.
HTTP_TIMEOUT_MS=10000
# [opcional | default 300] Menos caracteres que esto y el artículo se descarta.
MIN_CONTENT_LENGTH=300
# [opcional | default 2] Peticiones simultáneas al mismo dominio.
MAX_CONCURRENCY_PER_DOMAIN=2
# [opcional | default 200] Pausa mínima entre peticiones al mismo dominio, en ms.
MIN_DELAY_PER_DOMAIN_MS=200
# [opcional | default 5] Crawls vacíos seguidos antes de marcar un feed como muerto.
STALE_AFTER_EMPTY_CRAWLS=5
# [opcional | default 3] Fallos antes de saltarse un artículo / un feed completo.
LOCAL_FAIL_THRESHOLD=3
TOTAL_FAIL_THRESHOLD=3


# --- Fuentes que exigen raspado con sesión ---
# El Austral de Temuco publica su edición impresa tras un muro de pago. El
# scraper reenvía una cookie de sesión de una suscripción propia. Sin ella,
# registra una advertencia y devuelve vacío: no rompe el crawl.
# AUSTRAL_COOKIE=
# [solo scripts] ID del feed de El Austral, para el backfill puntual.
# AUSTRAL_FEED_ID=


# -----------------------------------------------------------------------------
# 4 · Pipeline editorial
# -----------------------------------------------------------------------------
# crawl → pre-assess → assess → select → publish. Ver `.context/story-pipeline.md`.

# [opcional | default 60] Un artículo crawleado más viejo que esto no se procesa.
MAX_ARTICLE_AGE_DAYS=60

# [opcional | default 18] TECHO EDITORIAL. Un artículo cuya fecha de publicación
# original supere estos meses no se publica, aunque se haya descubierto hoy.
# Impide que el descubrimiento por búsqueda saque archivo como si fuera noticia.
MAX_SOURCE_AGE_MONTHS=18

# [opcional | default 5] Relevancia mínima (1-10) para entrar en la selección.
SELECT_RELEVANCE_MIN=5
# [opcional | default 0.5] Proporción de candidatas que se seleccionan.
SELECT_RATIO=0.5
# [opcional | default 20] Historias por grupo enviadas al modelo selector.
SELECT_MAX_GROUP_SIZE=20
# [opcional | default 14] Días que una historia queda asignada a un tema.
STORY_ASSIGNMENT_DAYS=14

# [opcional] Concurrencia por etapa.
CONCURRENCY_CRAWL_FEEDS=3
CONCURRENCY_CRAWL_ARTICLES=3
CONCURRENCY_PREASSESS=10
CONCURRENCY_ASSESS=10
CONCURRENCY_SELECT=10
CONCURRENCY_RECLASSIFY=10


# -----------------------------------------------------------------------------
# 5 · Deduplicación y búsqueda semántica
# -----------------------------------------------------------------------------
# Ver `.context/dedup.md` y `.context/embeddings.md`.

# [opcional | default activado] Poner en `false` para apagar el agrupamiento.
DEDUP_ENABLED=true
# [opcional | default 14] Ventana en días para buscar historias duplicadas.
DEDUP_TIME_WINDOW_DAYS=14
# [opcional | default 6] Candidatas que se comparan por historia.
DEDUP_MAX_CANDIDATES=6

# [opcional] Generación de embeddings para la búsqueda híbrida.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CONCURRENCY=5
EMBEDDING_DELAY_MS=100


# -----------------------------------------------------------------------------
# 6 · Generación de imágenes
# -----------------------------------------------------------------------------
# Ver `.context/images.md`. Recurso Azure separado del de texto.

# [desactiva] Sin endpoint y clave no se generan imágenes.
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
# [opcional | default gpt-image-2]
AZURE_IMAGE_DEPLOYMENT=gpt-image-2
# [opcional | default 2025-04-01-preview]
AZURE_IMAGE_API_VERSION=2025-04-01-preview
# [opcional | default medium] low | medium | high. Sube el costo notoriamente.
AZURE_IMAGE_QUALITY=medium
AZURE_IMAGE_QUALITY_PORTRAIT=medium
# [opcional | default 8] Relevancia mínima para generarle imagen destacada.
AZURE_IMAGE_HERO_MIN_RELEVANCE=8

# [opcional] Directorio donde se cachean los favicons de las fuentes.
# FAVICON_DIR=


# -----------------------------------------------------------------------------
# 7 · Almacenamiento (Cloudflare R2)
# -----------------------------------------------------------------------------
# [desactiva] Sin R2 no hay imágenes hospedadas ni audio de podcast. Instagram
# depende de R2 porque su API exige una URL pública de la imagen.
R2_ENDPOINT=https://tu-cuenta.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=impacto-indigena-media
R2_PUBLIC_URL=https://tu-dominio-publico-r2.com


# -----------------------------------------------------------------------------
# 8 · Correo transaccional (Brevo)
# -----------------------------------------------------------------------------
# [desactiva] Sin clave no salen newsletters, alertas ni magic links.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# [opcional | default "Voces Indígenas"]
BREVO_FROM_NAME=Voces Indígenas
# [opcional] Segmento de prueba para envíos de ensayo.
BREVO_TEST_SEGMENT_ID=

# [opcional | default 24] Vigencia del enlace de confirmación de suscripción.
SUBSCRIBE_TOKEN_EXPIRY_HOURS=24
# [opcional | default 1.0] Versión del texto de consentimiento que se registra
# junto a cada alta. Subirla obliga a pedir consentimiento de nuevo.
CONSENT_VERSION=1.0


# -----------------------------------------------------------------------------
# 9 · Newsletter y podcast
# -----------------------------------------------------------------------------
# Ver `.context/newsletter-podcast.md`.

# [opcional | default 4] Historias por edición.
NEWSLETTER_STORIES_PER_ISSUE=4

# [opcional] Destinatario del boletín interno de control.
# PRIVATE_NEWSLETTER_EMAIL=

# [opcional | default desactivado] Poner en `true` para generar episodios solo.
PODCAST_AUTO_GENERATE_ENABLED=false
# [opcional | default 4]
PODCAST_STORIES_PER_EPISODE=4
# [opcional | default nova] Voz del modelo TTS.
PODCAST_VOICE=nova


# -----------------------------------------------------------------------------
# 10 · Redes sociales
# -----------------------------------------------------------------------------
# Seis canales. Cada `_AUTO_POST_ENABLED` es OPT-IN: hay que ponerlo
# explícitamente en `true`, y si falta el canal solo deja borradores.
# Un canal sin credenciales no rompe nada: simplemente no publica.

# --- Bluesky --- `.context/bluesky.md`
BLUESKY_AUTO_POST_ENABLED=false
BLUESKY_HANDLE=tuhandle.bsky.social
BLUESKY_APP_PASSWORD=
# [opcional | default https://bsky.social]
BLUESKY_SERVICE_URL=https://bsky.social
# [opcional | default 25] Ventana de historias candidatas, en horas.
BLUESKY_LOOKBACK_HOURS=25
# [opcional | default 2000] Pausa entre publicaciones, en ms.
BLUESKY_POST_DELAY_MS=2000
# [opcional | default 30] Días que se siguen midiendo métricas de un post.
BLUESKY_METRICS_MAX_AGE_DAYS=30

# --- Mastodon --- `.context/mastodon.md`
MASTODON_AUTO_POST_ENABLED=false
MASTODON_URL=https://mastodon.social
MASTODON_TOKEN=
# [opcional | default unlisted] public | unlisted | private
MASTODON_VISIBILITY=unlisted
# [opcional | default 500] Límite de caracteres de la instancia.
MASTODON_CHAR_LIMIT=500
MASTODON_POST_DELAY_MS=2000
MASTODON_METRICS_MAX_AGE_DAYS=30

# --- Instagram --- `.context/instagram.md`
# El token se renueva solo (job `instagram_refresh_token`). Depende de R2.
INSTAGRAM_AUTO_POST_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# [opcional | default 60] Vigencia del token largo, en días.
INSTAGRAM_TOKEN_LIFETIME_DAYS=60
# [opcional | default 15] Días antes del vencimiento en que se renueva.
INSTAGRAM_TOKEN_REFRESH_THRESHOLD_DAYS=15
INSTAGRAM_METRICS_MAX_AGE_DAYS=30

# --- LinkedIn --- `.context/linkedin.md`
# El token NO se renueva solo: la renovación programática está reservada a
# partners. El job `linkedin_check_token` avisa por correo y la reautorización
# es un clic en el panel.
LINKEDIN_AUTO_POST_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# [opcional] Debe coincidir exactamente con el registrado en la app de LinkedIn.
LINKEDIN_REDIRECT_URI=https://impactoindigena.news/api/linkedin/callback
# [opcional | default w_member_social]
LINKEDIN_OAUTH_SCOPES=w_member_social
LINKEDIN_TOKEN_LIFETIME_DAYS=60
# [opcional | default 7] Días de anticipación del aviso de vencimiento.
LINKEDIN_TOKEN_WARN_THRESHOLD_DAYS=7
LINKEDIN_METRICS_MAX_AGE_DAYS=30

# --- X / Twitter --- `.context/twitter.md`
# OAuth 1.0a con credenciales estáticas.
TWITTER_AUTO_POST_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# [opcional | default 7] Más corto que el resto por los límites del plan gratuito.
TWITTER_METRICS_MAX_AGE_DAYS=7

# --- Facebook Páginas --- `.context/facebook.md`
# El token de Instagram NO sirve acá: son APIs distintas. Publicar en GRUPOS es
# imposible por API desde que Meta cerró la Groups API en abril de 2024.
FACEBOOK_AUTO_POST_ENABLED=false
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_TOKEN_WARN_THRESHOLD_DAYS=7
FACEBOOK_METRICS_MAX_AGE_DAYS=30

# [opcional | default 25] Ventana de candidatas para el auto-post compartido.
SOCIAL_LOOKBACK_HOURS=25


# -----------------------------------------------------------------------------
# 11 · Agenda de incidencia internacional
# -----------------------------------------------------------------------------
# Ingesta de eventos y casos de organismos internacionales. A diferencia de las
# redes, estos son OPT-OUT: vienen activados y se apagan con `false`.

AGENDA_OHCHR_ENABLED=true
# [opcional | default 4] Páginas que recorre el scraper de OHCHR.
AGENDA_OHCHR_MAX_PAGES=4
AGENDA_CORTEIDH_ENABLED=true
# [opcional | default 6] Antigüedad máxima de los ítems RSS, en meses.
AGENDA_RSS_MAX_AGE_MONTHS=6

# [opcional] Límites del enriquecimiento por LLM de cada ítem.
AGENDA_ENRICH_DATE_LIMIT=20
AGENDA_ENRICH_TRANSLATE_LIMIT=20
AGENDA_ENRICH_CONTENT_MAX_CHARS=6000

# --- Digest semanal de la agenda ---
AGENDA_DIGEST_ENABLED=true
# [opcional] Ventanas de inclusión, en días.
AGENDA_DIGEST_DUE_WITHIN_DAYS=21
AGENDA_DIGEST_EVENT_WITHIN_DAYS=30
AGENDA_DIGEST_PUBLISHED_WITHIN_DAYS=7
# [opcional] Canales por los que sale el digest.
AGENDA_DIGEST_BLUESKY=true
AGENDA_DIGEST_MASTODON=true
AGENDA_DIGEST_TWITTER=false
AGENDA_DIGEST_INSTAGRAM=false
AGENDA_DIGEST_POST_DELAY_MS=2000

# [opcional] ID del feed al que se atribuyen los ítems raspados de DOCIP.
# DOCIP_FEED_ID=


# -----------------------------------------------------------------------------
# 12 · Límites de tasa
# -----------------------------------------------------------------------------
# Ventanas en milisegundos, máximos en peticiones por ventana y por IP.

# Rutas públicas de lectura — 100 cada 15 min.
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
# Búsqueda, que consume embeddings — 20 cada 15 min.
RATE_LIMIT_SEARCH_MAX=20
RATE_LIMIT_SEARCH_WINDOW_MS=900000
# Operaciones caras — 1000 por hora.
RATE_LIMIT_EXPENSIVE_MAX=1000
RATE_LIMIT_EXPENSIVE_WINDOW_MS=3600000
# Alta de suscripción — 3 por minuto.
SUBSCRIBE_RATE_LIMIT_MAX=3
SUBSCRIBE_RATE_LIMIT_WINDOW_MS=60000
# Envío de comentarios — 3 por hora.
FEEDBACK_RATE_LIMIT_MAX=3
FEEDBACK_RATE_LIMIT_WINDOW_MS=3600000


# -----------------------------------------------------------------------------
# 13 · Analítica propia y retención de datos
# -----------------------------------------------------------------------------
# Medición sin cookies ni terceros. El job `cleanup_analytics` borra lo vencido.

# [opcional | default 365] Días que se conservan los registros de visitantes.
# Este valor es una decisión de cumplimiento, no de rendimiento: fijarlo alto
# obliga a justificar el plazo. Ver la Política de Privacidad del sitio.
ANALYTICS_VISITOR_RETENTION_DAYS=365


# -----------------------------------------------------------------------------
# 14 · Feeds RSS y sitemap
# -----------------------------------------------------------------------------
# [opcional | default 50] Ítems que incluye el feed RSS.
RSS_FEED_SIZE=50
# [opcional | default 30] Ítems por tema.
RSS_ITEM_LIMIT=30
# [opcional | default 900] Cache-Control del feed, en segundos.
RSS_CACHE_MAX_AGE=900
# [opcional | default 3600] Cache-Control del sitemap, en segundos.
SITEMAP_CACHE_MAX_AGE=3600


# -----------------------------------------------------------------------------
# 15 · Datos abiertos
# -----------------------------------------------------------------------------
# [desactiva] Tokens separados por coma que habilitan el endpoint de datos
# abiertos. Sin ellos el endpoint queda cerrado.
# OPENDATA_API_TOKENS=


# -----------------------------------------------------------------------------
# 16 · Operación, alertas y registro
# -----------------------------------------------------------------------------

# [opcional] Correo que recibe las alertas de fallos y vencimientos de token.
# Sin este valor el código usa un correo por defecto codificado en fuente.
# ALERT_EMAIL=

# [opcional | default 6] Horas de silencio entre alertas repetidas.
ALERT_THROTTLE_HOURS=6

# [desactiva] Webhook opcional para notificaciones (Slack, Discord u otro).
# WEBHOOK_URL=

# [opcional | default info en producción, debug fuera] fatal|error|warn|info|debug|trace
LOG_LEVEL=debug
# [opcional | default logs]
LOG_DIR=logs
# [opcional | default 14] Días que se conservan los archivos de log rotados.
LOG_RETENTION_DAYS=14
